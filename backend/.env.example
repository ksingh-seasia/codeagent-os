DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/langgraph_db
REDIS_URL=redis://localhost:6379
SECRET_KEY=change_me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email delivery.
# Render blocks outbound SMTP ports (25/465/587), so on Render set one of these
# HTTPS provider keys -- SMTP alone will fail with "Network is unreachable".
BREVO_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
MAIL_FROM=no-reply@yourdomain.com

# Public portal URLs, used to build links inside outgoing emails.
SUPER_ADMIN_PORTAL_URL=http://localhost:3000
TENANT_ADMIN_PORTAL_URL=http://localhost:3001
DEVELOPER_PORTAL_URL=http://localhost:3002
